{
  "name": "paceup",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source community platform for endurance sports clubs",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @paceup/api run dev",
    "dev:web": "npm --workspace @paceup/web run dev",
    "build": "npm run build --workspace @paceup/web",
    "start": "npm run start --workspace @paceup/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
