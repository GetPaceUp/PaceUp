# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Database (SQLite for the initial deployment)
DATABASE_URL=file:./data/paceup.sqlite

# Set a unique random value of at least 32 characters in production.
APP_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# How long a sign-in lasts on a device, in days. Signing out ends it immediately.
SESSION_TTL_DAYS=90

# Proxy addresses trusted for X-Forwarded-For (client IP for rate limiting).
# The API listens on 127.0.0.1 behind Caddy, so the default "loopback" is correct.
TRUST_PROXY=loopback

# WhatsApp worker (apps/api/src/whatsapp/worker.js, systemd unit deploy/paceup-whatsapp.service).
# WHATSAPP_ADAPTER=baileys (default) or fake for local development without a phone.
# Linked-device sessions are stored per club under WHATSAPP_DATA_DIR
# (default: a "whatsapp" folder next to the database). Never commit them.
# PACEUP_TIMEZONE controls message times and quiet hours (default Asia/Kolkata).

# Registered email address of the initial PaceUp platform owner
PACEUP_SUPERADMIN_EMAIL=
