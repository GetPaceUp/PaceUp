# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Database (SQLite for the initial deployment)
DATABASE_URL=file:./data/paceup.sqlite

# Set a unique random value of at least 32 characters in production.
APP_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Messaging provider configuration will be added when the adapter is implemented.
# Never commit provider credentials or WhatsApp session files.
